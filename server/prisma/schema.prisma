generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  email     String     @unique
  password  String
  isVerified      Boolean   @default(false)
  verificationOtp String?
  otpExpires      DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorOtp     String?
  twoFactorOtpExpires DateTime?
  loginAttempts   Int       @default(0)
  lockUntil       DateTime?
  resetToken      String?
  resetTokenExpires DateTime?
  // Bumped on password reset; embedded in issued JWTs and checked on each
  // authenticated request so old sessions are invalidated (SRV-M2).
  tokenVersion    Int       @default(0)
  // Per-account failed-OTP counter to complement the per-IP limiter (SRV-M4).
  otpAttempts     Int       @default(0)
  expenses  Expense[]
  incomes   Income[]
  budgets   Budget[]
  semesters Semester[]
  settings  UserSettings?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Expense {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  amount           Int    // integer cents
  category         String
  date             DateTime @db.Date
  paymentMethod    String?
  notes            String?
  originalAmount   Int?   // integer cents
  originalCurrency String?
  isRecurring      Boolean? @default(false)
  tags             String[]
  metadata         Json?
  taxCategory      String?
  isTaxDeductible  Boolean? @default(false)
  splitParticipants String[]
  splitShares      Int[]  // integer cents
  receiptText      String?
  receiptFileName  String?
  // Which real-world account/card this came from (e.g. "Discover", "USCCU
  // Checking"). paymentMethod says HOW it was paid; account says WHICH source,
  // so two cards that are both "Credit Card" stay distinguishable.
  account          String?
  // Optional: tags this expense to a shared household so members can pool it.
  householdId      String?  @db.ObjectId
  // Idempotency key for offline-queued creates: replaying the same key returns
  // the existing row instead of creating a duplicate.
  clientRequestId  String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String   @db.ObjectId
  @@index([userId])
  @@index([userId, date])
  @@index([userId, category, date])
  @@index([userId, account])
  @@index([householdId])
  @@index([userId, clientRequestId])
}

model Income {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  amount           Int    // integer cents
  category         String
  date             DateTime @db.Date
  notes            String?
  originalAmount   Int?   // integer cents
  originalCurrency String?
  tags             String[]
  metadata         Json?
  // Which real-world account this landed in. Mirrors Expense.account.
  account          String?
  // Idempotency key for bulk/offline creates: replaying the same key is a no-op
  // instead of inserting the batch twice. Mirrors Expense.clientRequestId.
  clientRequestId  String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String   @db.ObjectId
  @@index([userId])
  @@index([userId, date])
  @@index([userId, account])
  @@index([userId, clientRequestId])
}

model Budget {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  category String
  amount   Int // integer cents
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String @db.ObjectId

  @@unique([userId, category], name: "userId_category")
  @@index([userId])
}

model Semester {
  // MongoDB MUST have a single _id primary key
  id_internal  String @id @default(auto()) @map("_id") @db.ObjectId
  
  id           String // This is your 'fall-2025' string
  name         String
  totalTuition Int // integer cents
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String @db.ObjectId
  installments TuitionInstallment[]

  // Use @@unique instead of @@id for composite uniqueness in MongoDB
  @@unique([id, userId], name: "id_userId")
  @@index([userId])
}

model TuitionInstallment {
  // autoincrement() is not supported in MongoDB
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  amount         Int // integer cents
  status         String
  expenseId      String?
  paidDate       DateTime? @db.Date
  
  // Relating to Semester's custom unique constraint
  semester       Semester  @relation(fields: [semesterId, semesterUserId], references: [id, userId], onDelete: Cascade)
  semesterId     String
  semesterUserId String    @db.ObjectId
  @@index([semesterId, semesterUserId])
}
model Household {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  ownerId   String            @db.ObjectId
  createdAt DateTime          @default(now())
  members   HouseholdMember[]
  @@index([ownerId])
}

model HouseholdMember {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId  String    @db.ObjectId
  // null while an emailed invite hasn't been accepted (or the email isn't a user yet)
  userId       String?   @db.ObjectId
  invitedEmail String
  role         String    @default("member") // 'owner' | 'member'
  status       String    @default("invited") // 'invited' | 'active'
  createdAt    DateTime  @default(now())
  @@index([householdId])
  @@index([userId])
  @@index([invitedEmail])
}

model Receipt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expenseId String   @unique @db.ObjectId
  userId    String   @db.ObjectId
  // Downscaled JPEG as a data URL (kept out of the /all payload so lists stay lean).
  image     String
  createdAt DateTime @default(now())
  @@index([userId])
}

// Sessions ended by logout. Session JWTs carry a random `jti`; logout records it
// here so that token stops working at once instead of staying valid for up to
// 7 days. Rows are pruned once the token would have expired anyway.
model RevokedToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  jti       String   @unique
  userId    String   @db.ObjectId
  expiresAt DateTime
  @@index([expiresAt])
}

// Per-account preferences and planning data that used to live only in the
// browser's localStorage, so they now follow the account across devices and are
// part of backups. One document per user; each field is replaced as a whole by
// PATCH /api/settings. Money inside the JSON fields is integer cents, like
// every other amount, converted at the API boundary (utils/settings.ts).
model UserSettings {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String    @unique @db.ObjectId
  displayCurrency      String?
  hideTuition          Boolean?
  onboardingDismissed  Boolean?
  recurringSnoozeUntil DateTime?
  customCategories     Json?     // { main: [subcategory, …] } added to the built-ins
  deletedSubcategories Json?     // { main: [subcategory, …] } built-ins the user removed
  merchantMap          Json?     // { merchant key: category } learned from the user's choices
  pausedRecurring      Json?     // { recurring template key: true }
  savingsGoals         Json?     // [{ id, name, target, saved, deadline? }] (cents)
  investmentAccounts   Json?     // [{ id, name, type, value, asOf }] (cents)
  updatedAt            DateTime  @updatedAt
}
