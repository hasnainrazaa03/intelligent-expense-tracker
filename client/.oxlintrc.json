{
  // oxlint, not ESLint: typescript-eslint can't parse with TypeScript 7 (the
  // native compiler has no JS API yet), and oxlint ships its own TS parser plus
  // the React hooks rules. `// eslint-disable-next-line` comments still work.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    // React Compiler readiness: no impure calls (Date.now(), new Date()) during
    // render, no setState called synchronously in an effect, no refs read or
    // written during render. Fixed in 6c; two documented exceptions remain
    // (useRecurringSuggestions, useOfflineQueue).
    "react/purity": "error",
    "react/set-state-in-effect": "error",
    "react/refs": "error",
    "react/preserve-manual-memoization": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "tests/e2e/.auth/**", "public/sw.js"]
}
